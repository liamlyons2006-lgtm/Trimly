# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.

# --- Database ---
# Postgres connection string. On Replit, provision a DB and it sets this for you.
# Locally: postgresql://user:password@localhost:5432/trimly
DATABASE_URL=

# --- Plaid (Sandbox) ---
# From https://dashboard.plaid.com/ → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (default) | production
PLAID_ENV=sandbox

# --- Server ---
PORT=5000
